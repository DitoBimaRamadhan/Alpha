# Salin file ini menjadi .env lalu isi nilainya. Jangan commit file .env!

# Kunci API dari https://console.groq.com/keys
GROQ_API_KEY=

# Model Groq yang dipakai (lihat https://console.groq.com/docs/models)
GROQ_MODEL=openai/gpt-oss-20b

# Database. Kosongkan untuk SQLite lokal (alpha.db di root proyek).
# Contoh PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/alpha
DATABASE_URL=

# Origin yang boleh memanggil API (pisahkan dengan koma), "*" = semua
CORS_ORIGINS=*
